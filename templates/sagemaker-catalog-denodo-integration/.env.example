# AWS Configuration
AWS_REGION=aws-region-of-your-datazone-domain
DATAZONE_DOMAIN_ID=your-datazone-domain-id
DATAZONE_PROJECT_ID=your-datazone-project-id

# Denodo Configuration
DENODO_HOST=localhost
DENODO_PORT=9999
DENODO_DATABASE=your-denodo-database-name
DENODO_USER=your-denodo-username
DENODO_PASSWORD=your-denodo-password

# JDBC Driver (download from Denodo's support site and place in the drivers/ folder)
JDBC_DRIVER_PATH=./drivers/your-denodo-jdbc-driver.jar